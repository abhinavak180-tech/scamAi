{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/health",
            "dest": "app.py"
        },
        {
            "src": "/analyze-text",
            "dest": "app.py"
        },
        {
            "src": "/analyze-image",
            "dest": "app.py"
        },
        {
            "src": "/analyze-audio",
            "dest": "app.py"
        },
        {
            "src": "/chat",
            "dest": "app.py"
        },
        {
            "src": "/",
            "dest": "/check-message.html"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}